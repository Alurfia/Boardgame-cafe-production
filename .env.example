# Data source: "json" (mock API, no Supabase needed) or "db" (real Supabase).
# Leave unset to auto-select: "db" when a Supabase URL is present, else "json".
NEXT_PUBLIC_DATA_MODE=json

# Supabase Configuration (only used when the mode resolves to "db")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signing key for the /admin session cookie. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in development (a fixed insecure fallback is used); REQUIRED in
# production — the app throws on startup without it. Changing it signs everyone out.
ADMIN_SESSION_SECRET=Die3edm0ikjFk1m8E

# Auto checkout — the daily sweep that closes sessions nobody checked out.
# Scheduled by vercel.json at 03:00 UTC = 10:00 Asia/Bangkok.
#
# Shared secret Vercel Cron sends as "Authorization: Bearer <secret>". Set it in
# the Vercel project (any long random string) or the endpoint is reachable by
# anyone who guesses the URL. Unset, the route is open in development and closed
# in production.
CRON_SECRET=

# A session active this long is treated as forgotten and swept (default: 5).
# Anything that crosses midnight in CAFE_TIME_ZONE is swept regardless.
# AUTO_CHECKOUT_AFTER_HOURS=5
# The cafe's wall clock, used to decide what "overnight" means (default: Asia/Bangkok)
# CAFE_TIME_ZONE=Asia/Bangkok

# json mode only, both optional
# Where the mock database is stored (default: ./data/mock-db.json)
# MOCK_DB_FILE=
# How often the browser polls for changes, in ms (default: 2000)
# NEXT_PUBLIC_MOCK_POLL_MS=2000
